	<!-- Firestorm -->
	
  <AbilityDef ParentName="PsycastBase">
    <defName>FSFFirestorm</defName>
    <label>firestorm</label>
    <description>Generate a large skipgate linked to a nearby star to cause an enormous burst of flames.  Everything in range including the caster will be caught in the ensuing wave of fire.  Casting this takes 12 seconds of meditation, and afterwards, the caster will go into a two and a half day psychic coma.</description>
    <level>6</level>
    <iconPath>UI/Abilities/FSFFirestorm</iconPath>
	<jobDef>CastAbilityOnThingUninterruptible</jobDef>
    <targetRequired>False</targetRequired>
	<showPsycastEffects>False</showPsycastEffects>
	<showCastingProgressBar>True</showCastingProgressBar>
    <warmupMote>Mote_WarmupNeuroquake</warmupMote>
    <warmupStartSound>Psycast_Neuroquake_CastStart</warmupStartSound>
    <warmupSound>Psycast_Neuroquake_CastLoop</warmupSound>
    <warmupPreEndSound>Psycast_Neuroquake_CastEnd</warmupPreEndSound>
    <warmupPreEndSoundSeconds>5</warmupPreEndSoundSeconds>
    <writeCombatLog>True</writeCombatLog>
    <statBases>
      <Ability_PsyfocusCost>0.5</Ability_PsyfocusCost>
      <Ability_Duration>2400</Ability_Duration>
    </statBases>
    <verbProperties>
      <warmupTime>12</warmupTime>
	  <range>50</range>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilitySpawn">
        <thingDef>FSFFirestorm</thingDef>
        <allowOnBuildings>false</allowOnBuildings>
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>PsychicComa</hediffDef>
        <onlyApplyToSelf>True</onlyApplyToSelf>
      </li>
    </comps>
    <confirmationDialogText>Firestorm takes 12 seconds to cast, and cannot be interrupted. When complete, the caster will fall into a psychic coma for 2.5 days.\n\nEveryone in range including the caster will be hit by a wave of fire.\n\nDo you really want to cast firestorm?</confirmationDialogText>
  </AbilityDef>
	
  <ThingDef>
    <defName>FSFFirestorm</defName>
    <label>Firestorm</label>
    <description>This item does not exist if your reading this, what have you done?</description>
    <category>Ethereal</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Security/IEDEMP</texPath>
      <drawSize>(0,0)</drawSize>
	</graphicData>
	<size>(0, 0)</size>
    <thingClass>ThingWithComps</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>MoteLow</altitudeLayer>
    <comps>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>0</lifespanTicks>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>0</wickTicks>
		<damageAmountBase>30</damageAmountBase>
		<armorPenetrationBase>2.0</armorPenetrationBase>
		<chanceToStartFire>1.0</chanceToStartFire>
        <explosiveRadius>50</explosiveRadius>
        <explosiveDamageType>Flame</explosiveDamageType>
		<explosionEffect>GiantExplosion</explosionEffect>
        <explodeOnKilled>true</explodeOnKilled>
      </li>
    </comps>
  </ThingDef>
	
